{
  "id": "extract-audio",
  "name": "Extract audio to MP3",
  "tool": "ffmpeg",
  "confidence": "validated",
  "args": [
    { "kind": "flag", "name": "-hide_banner" },
    { "kind": "option", "name": "-i", "value": "{{input}}" },
    { "kind": "flag", "name": "-vn" },
    { "kind": "option", "name": "-c:a", "value": "libmp3lame" },
    { "kind": "option", "name": "-q:a", "value": "2" },
    { "kind": "value", "name": "output", "value": "{{output}}" }
  ]
}
