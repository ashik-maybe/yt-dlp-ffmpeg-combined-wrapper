{
  "id": "crf-tuning",
  "name": "CRF quality tune",
  "tool": "ffmpeg",
  "confidence": "validated",
  "args": [
    { "kind": "flag", "name": "-hide_banner" },
    { "kind": "option", "name": "-i", "value": "{{input}}" },
    { "kind": "option", "name": "-c:v", "value": "libx264" },
