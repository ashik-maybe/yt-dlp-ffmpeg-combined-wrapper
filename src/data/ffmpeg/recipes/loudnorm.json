{
  "id": "loudnorm",
  "name": "Loudness normalize",
  "tool": "ffmpeg",
  "confidence": "validated",
  "args": [
    { "kind": "flag", "name": "-hide_banner" },
    { "kind": "option", "name": "-i", "value": "{{input}}" },
    { "kind": "option", "name": "-af", "value": "loudnorm=I=-16:TP=-1.5:LRA=11" },
    { "kind": "option", "name": "-c:v", "value": "copy" },
    { "kind": "option", "name": "-c:a", "value": "aac" },
    { "kind": "option", "name": "-b:a", "value": "192k" },
    { "kind": "value", "name": "output", "value": "{{output}}" }
  ]
}
