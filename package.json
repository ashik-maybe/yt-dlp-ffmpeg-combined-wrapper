{
  "name": "yt-dlp-ffmpeg-combined-wrapper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tui:test": "vitest run tests/tui",
    "spec:check": "node scripts/spec-check.mjs",
    "readme:check": "node scripts/readme-check.mjs",
    "ci": "bun run lint && bun run format:check && bun run typecheck && bun run spec:check && bun run readme:check && bun run test && bun run tui:test"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
